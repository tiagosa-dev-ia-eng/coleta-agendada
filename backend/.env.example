# Copie para .env e ajuste (doc 13 §4)
DJANGO_SECRET_KEY=Ew5ZeqDXAg7S0Y5r7ZaWM1UkDt8AH09etoVlzhyOyx15ihooAt2GvKObXhoduwxi
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0

# Segurança (doc 11 §2)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_HOUR=100
LOGIN_RATE_PER_MINUTE=10

# JWT (M1)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# IA / WhatsApp (M8) — parâmetros oficiais de IA (B-07, decisão 04/09/2026):
# - DEEPSEEK_MOCK=1 força o mock mesmo com chave (validar respostas sem tokens)
# - AI_MIN_CONFIDENCE: abaixo dele o chatbot encaminha a humano
# - DEEPSEEK_BASE_URL: default https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MIN_CONFIDENCE=0.7
DEEPSEEK_MOCK=0
WHATSAPP_PROVIDER=simulator
WHATSAPP_WEBHOOK_SECRET=

# Pagamentos (B-01): PAYMENT_GATEWAY=fake|pagarme
PAYMENT_GATEWAY=fake
PAGARME_SECRET_KEY=
PAGARME_BASE_URL=https://api.pagar.me/core/v5

# WhatsApp Z-PRO (B-03, outbound; simulador por padrão)
ZPRO_BASE_URL=
ZPRO_TOKEN=
ZPRO_SEND_PATH=

# Agendamento
APPOINTMENT_SLOT_MINUTES=30

# Orçamento (B-05)
QUOTATION_VALIDITY_DAYS=15